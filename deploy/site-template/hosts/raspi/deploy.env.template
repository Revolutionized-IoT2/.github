# deploy/.env of a Raspberry Pi node (compose.node-raspi.yml). Fill in, then encrypt it as
# deploy.sops.env (README.md, "Start a site"):
#
#   sops encrypt --filename-override hosts/raspi/deploy.sops.env --output hosts/raspi/deploy.sops.env hosts/raspi/deploy.env.template
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=compose.node-raspi.yml

# The Pi's own address, its node id (unique on the broker), and the main installation's broker.
RIOT2_HOST=192.168.1.40
RIOT2_NODE_ID=riot2-raspi
RIOT2_NODE_HOST_PORT=80
RIOT2_MQTT_IP=192.168.1.30
RIOT2_MQTT_USERNAME=riot2
RIOT2_MQTT_PASSWORD=
TZ=Europe/Helsinki
# The main installation's collector (compose.lan.observability.yml); empty sends no metrics.
OTEL_EXPORTER_OTLP_ENDPOINT=http://192.168.1.36:4317
