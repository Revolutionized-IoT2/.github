# RIoT2 settings for the compose files in this folder. Copy this file to .env, fill in the
# required values, then run "docker compose up -d --wait". Keep .env private: it holds passwords.
# Every variable is described in docs/contracts/env-vars.md.

# ---------------------------------------------------------------------------- Required
# LAN address (IP or DNS name) of this Docker host. Browsers, nodes and ESP32 firmware connect to
# it, so it can't be localhost.
RIOT2_HOST=
# The broker account. Mosquitto creates it on every start; every service and the UI use it.
RIOT2_MQTT_USERNAME=riot2
RIOT2_MQTT_PASSWORD=
# Signs Elsa Studio's login tokens. Generate it with: openssl rand -base64 48
ELSA_IDENTITY_SIGNING_KEY=

# ---------------------------------------------------------------------------- Ids
# Each id must be unique across everything connected to the broker: it is also the MQTT client id.
RIOT2_ORCHESTRATOR_ID=riot2-orchestrator
RIOT2_WORKFLOW_ID=riot2-elsa
RIOT2_NODE_ID=riot2-node-1

# ---------------------------------------------------------------------------- Optional
TZ=Europe/Helsinki
# Log format of every .NET service: text (readable) or json (compact JSON, for log collectors).
RIOT2_LOG_FORMAT=text
# The lowest level logged: Trace, Debug, Information, Warning, Error or Critical. Framework
# messages (Microsoft.*, System.*) start at Warning unless this is higher.
RIOT2_LOG_LEVEL=Information
# Seconds a workflow trigger waits for Elsa, and a command for its node, before it expires.
RIOT2_OUTBOX_WORKFLOW_TTL=300
RIOT2_OUTBOX_COMMAND_TTL=30
# Where Elsa's RIoT Schedule calculates sunrise and sunset: decimal degrees, north and east
# positive (Helsinki: 60.17 and 24.94). Both or neither; empty: sun-based schedules don't fire.
RIOT2_LATITUDE=
RIOT2_LONGITUDE=
# Configuration backups to the orchestrator-backups volume: a Quartz cron expression with seconds,
# in TZ (03:00 every day here; empty turns them off), and how many backups are kept.
RIOT2_BACKUP_SCHEDULE="0 0 3 * * ?"
RIOT2_BACKUP_RETENTION=7
# Metrics of every .NET service (design 7.4): with compose.observability.yml set the endpoint to
# http://otel-collector:4317; empty sends nothing. The export interval is in milliseconds.
# RIOT2_TRACING=true also sends traces, which the bundled collector only logs.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_METRIC_EXPORT_INTERVAL=15000
RIOT2_TRACING=false
# The optional security mode (design 7.5, docs/guides/security.md). This release accepts off only:
# the seams are in place, and nothing is enforced.
RIOT2_SECURITY_MODE=off
# Each service's API key, sent in X-RIoT2-Key on its calls to other services. They can be set
# before the mode is switched on; while it is off nothing checks them. Empty sends none.
RIOT2_ORCHESTRATOR_API_KEY=
RIOT2_ELSA_API_KEY=
RIOT2_NODE_API_KEY=
RIOT2_CONNECTOR_API_KEY=
# Host ports. The service URLs that compose builds from RIOT2_HOST follow them.
# The broker always uses 1883 (MQTT) and 9001 (WebSocket for the UI).
RIOT2_UI_HOST_PORT=80
RIOT2_ORCHESTRATOR_HOST_PORT=8080
RIOT2_NODE_HOST_PORT=8081
RIOT2_ELSA_HOST_PORT=8082
RIOT2_ELSA_GRPC_HOST_PORT=5003
# Host folder mounted as the node's Plugins/ ("--profile node").
RIOT2_NODE_PLUGINS=./plugins

# ---------------------------------------------------------------------------- InfluxDB and Grafana
# Only for compose.influx.yml. The three empty values are required there.
# InfluxDB admin token, shared by the connector and Grafana: openssl rand -hex 32
RIOT2_INFLUXDB_TOKEN=
# InfluxDB's admin login (the password needs at least 8 characters) and Grafana's admin password,
# which compose.observability.yml needs too.
RIOT2_INFLUXDB_ADMIN_USERNAME=admin
RIOT2_INFLUXDB_ADMIN_PASSWORD=
RIOT2_GRAFANA_ADMIN_PASSWORD=
RIOT2_INFLUXDB_ORGANIZATION=riot2
RIOT2_INFLUXDB_BUCKET=riot2
RIOT2_CONNECTOR_ID=riot2-influxdb
# true also writes every command to InfluxDB.
RIOT2_HANDLE_COMMANDS=false
# The connector's disk spool: messages wait on disk while InfluxDB is down, up to the size and age limits.
RIOT2_CONNECTOR_SPOOL=true
RIOT2_CONNECTOR_SPOOL_MAX_MB=100
RIOT2_CONNECTOR_SPOOL_MAX_AGE_DAYS=7
RIOT2_INFLUXDB_HOST_PORT=8086
RIOT2_GRAFANA_HOST_PORT=3000

# ---------------------------------------------------------------------------- Metrics
# Only for compose.observability.yml (and RIOT2_GRAFANA_ADMIN_PASSWORD above). OTLP is published for
# nodes on other hosts; Prometheus keeps the metrics for RIOT2_METRICS_RETENTION.
RIOT2_OTLP_HOST_PORT=4317
RIOT2_PROMETHEUS_HOST_PORT=9090
RIOT2_METRICS_RETENTION=15d
# The RIoT2 Prometheus exporter: a report value not sent again within this many minutes leaves
# /metrics. Its API key is only used once the security mode is on.
RIOT2_PROMETHEUS_MAX_AGE_MINUTES=60
RIOT2_PROMETHEUS_EXPORTER_API_KEY=

# ---------------------------------------------------------------------------- Home Assistant
# Only for compose.homeassistant.yml. Empty RIOT2_HA_MQTT_IP: Home Assistant uses the RIoT2 broker.
# Otherwise its broker's address, port (1883, 8883 with TLS) and account. The API key is only used
# once the security mode is on, and needs the operator role (the connector sends commands).
RIOT2_HA_MQTT_IP=
RIOT2_HA_MQTT_PORT=
RIOT2_HA_MQTT_USERNAME=
RIOT2_HA_MQTT_PASSWORD=
RIOT2_HA_MQTT_TLS=false
RIOT2_HA_DISCOVERY_PREFIX=homeassistant
RIOT2_HA_TOPIC_PREFIX=riot2/ha
RIOT2_HA_COMMAND_TTL_SECONDS=60
RIOT2_HOMEASSISTANT_API_KEY=

# ---------------------------------------------------------------------------- Raspberry Pi node
# Only for compose.node-raspi.yml, in a separate .env on the Pi. There, RIOT2_HOST is the Pi's
# address, RIOT2_NODE_ID the node's own id, RIOT2_MQTT_USERNAME and RIOT2_MQTT_PASSWORD the
# broker account above, and RIOT2_NODE_PLUGINS the plugin folder. Also set:
# RIOT2_MQTT_IP=<address of the broker host>
# RIOT2_NODE_HOST_PORT=80
