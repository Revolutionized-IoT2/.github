# RIoT2 settings for the compose files in this folder. Copy this file to .env, fill in the
# required values, then run "docker compose up -d --wait". Keep .env private: it holds passwords.
# Every variable is described in docs/contracts/env-vars.md.

# ---------------------------------------------------------------------------- Required
# LAN address (IP or DNS name) of this Docker host. Browsers, nodes and ESP32 firmware connect to
# it, so it can't be localhost.
RIOT2_HOST=
# The broker account. Mosquitto creates it on every start; every service and the UI use it.
RIOT2_MQTT_USERNAME=riot2
RIOT2_MQTT_PASSWORD=
# Signs Elsa Studio's login tokens. Generate it with: openssl rand -base64 48
ELSA_IDENTITY_SIGNING_KEY=

# ---------------------------------------------------------------------------- Ids
# Each id must be unique across everything connected to the broker: it is also the MQTT client id.
RIOT2_ORCHESTRATOR_ID=riot2-orchestrator
RIOT2_WORKFLOW_ID=riot2-elsa
RIOT2_NODE_ID=riot2-node-1

# ---------------------------------------------------------------------------- Optional
TZ=Europe/Helsinki
# Seconds a workflow trigger waits for Elsa before it expires.
RIOT2_OUTBOX_WORKFLOW_TTL=300
# Host ports. The service URLs that compose builds from RIOT2_HOST follow them.
# The broker always uses 1883 (MQTT) and 9001 (WebSocket for the UI).
RIOT2_UI_HOST_PORT=80
RIOT2_ORCHESTRATOR_HOST_PORT=8080
RIOT2_NODE_HOST_PORT=8081
RIOT2_ELSA_HOST_PORT=8082
RIOT2_ELSA_GRPC_HOST_PORT=5003
# Host folder mounted as the node's Plugins/ ("--profile node").
RIOT2_NODE_PLUGINS=./plugins

# ---------------------------------------------------------------------------- InfluxDB and Grafana
# Only for compose.influx.yml. The three empty values are required there.
# InfluxDB admin token, shared by the connector and Grafana: openssl rand -hex 32
RIOT2_INFLUXDB_TOKEN=
# InfluxDB's admin login (the password needs at least 8 characters) and Grafana's admin password.
RIOT2_INFLUXDB_ADMIN_USERNAME=admin
RIOT2_INFLUXDB_ADMIN_PASSWORD=
RIOT2_GRAFANA_ADMIN_PASSWORD=
RIOT2_INFLUXDB_ORGANIZATION=riot2
RIOT2_INFLUXDB_BUCKET=riot2
RIOT2_CONNECTOR_ID=riot2-influxdb
# true also writes every command to InfluxDB.
RIOT2_HANDLE_COMMANDS=false
RIOT2_INFLUXDB_HOST_PORT=8086
RIOT2_GRAFANA_HOST_PORT=3000

# ---------------------------------------------------------------------------- Raspberry Pi node
# Only for compose.node-raspi.yml, in a separate .env on the Pi. There, RIOT2_HOST is the Pi's
# address, RIOT2_NODE_ID the node's own id, RIOT2_MQTT_USERNAME and RIOT2_MQTT_PASSWORD the
# broker account above, and RIOT2_NODE_PLUGINS the plugin folder. Also set:
# RIOT2_MQTT_IP=<address of the broker host>
# RIOT2_NODE_HOST_PORT=80
