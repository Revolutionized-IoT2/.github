# deploy/.env of the main installation (a QNAP NAS here): the installer writes this file there. Fill
# in the empty values. It holds passwords and tokens: keep the site folder private.
#
# Every variable is described in deploy/.env.example and docs/contracts/env-vars.md. The addresses
# are examples: use free addresses of your own LAN, outside the router's DHCP pool.

# The compose files and profiles, so that plain "docker compose" commands, backup.sh and restore.sh
# use them too. COMPOSE_PATH_SEPARATOR makes the ":" list work on a Windows host as well.
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:compose.influx.yml:compose.observability.yml:compose.homeassistant.yml:compose.netatmo-cloudflare.yml:compose.mcp-cloudflare.yml:compose.lan.yml:compose.lan.influx.yml:compose.lan.observability.yml
COMPOSE_PROFILES=node

# The NAS's own address (still required by docker-compose.yml; compose.lan.yml replaces it in the URLs).
RIOT2_HOST=192.168.1.13
RIOT2_MQTT_USERNAME=riot2
RIOT2_MQTT_PASSWORD=
TZ=Europe/Helsinki
RIOT2_NODE_ID=riot2-node-1
# Workflows run in the orchestrator.
RIOT2_WORKFLOW_MODE=embedded
RIOT2_LATITUDE=
RIOT2_LONGITUDE=
# Metrics of every service go to the collector (compose.observability.yml).
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Static LAN addresses (compose.lan*.yml); install.sh creates the network from site.conf.
RIOT2_LAN_NETWORK=riot2-lan
RIOT2_LAN_IP_MQTT=192.168.1.30
RIOT2_LAN_IP_UI=192.168.1.31
RIOT2_LAN_IP_ORCHESTRATOR=192.168.1.32
RIOT2_LAN_IP_NODE=192.168.1.33
RIOT2_LAN_IP_INFLUXDB=192.168.1.34
RIOT2_LAN_IP_GRAFANA=192.168.1.35
RIOT2_LAN_IP_OTEL=192.168.1.36
RIOT2_LAN_IP_PROMETHEUS=192.168.1.37

# InfluxDB and Grafana. The token: openssl rand -hex 32; the admin password at least 8 characters.
RIOT2_INFLUXDB_TOKEN=
RIOT2_INFLUXDB_ADMIN_PASSWORD=
RIOT2_GRAFANA_ADMIN_PASSWORD=

# One Cloudflare Tunnel for Netatmo's webhook (to http://node:80) and remote AI access (to
# http://orchestrator:8090) (docs/guides/netatmo.md, docs/guides/remote-ai-access.md).
CLOUDFLARE_TUNNEL_TOKEN=
RIOT2_MCP_PUBLIC_URL=
RIOT2_MCP_CF_TEAM_DOMAIN=
RIOT2_MCP_AUTH_AUDIENCE=
RIOT2_MCP_REMOTE_MAX_ROLE=operator
RIOT2_MCP_ALLOWED_SUBJECTS=
