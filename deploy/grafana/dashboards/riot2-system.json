    {
      "id": 2,
      "type": "stat",
      "title": "Nodes online",
      "datasource": {
        "type": "prometheus",
        "uid": "riot2-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "riot2-prometheus"
          },
          "expr": "sum by (type) (riot2_nodes_online)",
          "legendFormat": "{{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "Nodes that announced themselves online, by type."
    },
