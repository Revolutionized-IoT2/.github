# What was entered in the M5Dial's setup portal (RIoT2-Setup-XXXX, http://192.168.4.1/), kept so the
# device can be set up again after a factory reset. Nothing reads this file.
NODE_ID=riot2-m5dial
NODE_NAME=M5Dial
WIFI_SSID=
WIFI_PASSWORD=
# The broker's static address (RIOT2_LAN_IP_MQTT); TLS only with a TLS listener (port 8883).
MQTT_URL=192.168.1.30
MQTT_USER=riot2
MQTT_PASSWORD=
MQTT_TLS=false
